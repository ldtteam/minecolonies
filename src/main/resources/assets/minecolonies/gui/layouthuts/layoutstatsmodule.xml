<window size="190 244"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image size="190 244" source="minecolonies:textures/gui/builderhut/builder_paper.png" />
    <text color="black" label="$(com.minecolonies.core.gui.modules.stats)" pos="30 14" size="130 11"
          textalign="MIDDLE" />
    <view pos="0 0" size="200 243">
        <dropdown id="intervals"
                  color="black"
                  dropDownSize="140 75"
                  maxContentHeight="75"
                  pos="30 30"
                  size="129 17"
                  source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png">
            <button id="button" color="black" label="$(com.minecolonies.coremod.gui.interval.yesterday)" pos="0 0" size="129 17"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" />
        </dropdown>
        <list id="stats" emptycolor="black" emptytext="$(com.minecolonies.core.gui.modules.stats.empty)" pos="20 55" size="160 160">
            <text id="desc" color="black" pos="0 0" size="160 13" wrap="true" />
        </list>
        <text color="black" label="$(com.minecolonies.core.gui.modules.stats.hidezerolabel)" pos="20 220" size="105 11"
              textalign="MIDDLE_RIGHT" />
        <button id="hidezero" disabled="minecolonies:textures/gui/builderhut/builder_button_mini_disabled.png" pos="127 218"
                size="14 15"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" />
    </view>
</window>
