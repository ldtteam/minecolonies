<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image id="deliveryImage" pos="1 3" size="16 16" source="minecraft:textures/misc/shadow.png" visible="false" />
    <button id="detail" pos="1 23" size="16 16" source="minecolonies:textures/gui/citizen/detail_button.png" />
    <itemicon id="requestStack" pos="1 3" size="16 16" />

    <text id="shortDetail" color="black" pos="20 2" size="130 9" />
    <itemicon id="detailIcon" pos="85 1" size="9 9" />

    <text id="requester" color="black" pos="20 13" size="130 9" />

    <!-- Color green if possible? -->
    <button id="fulfill" color="black" label="$(com.minecolonies.coremod.gui.citizen.requestsfulfill)" pos="20 23"
            size="37 16" source="minecolonies:textures/gui/citizen/colonist_button_small.png" />

    <!-- button to cancel the request-->
    <button id="cancel" color="black" label="$(com.minecolonies.coremod.gui.citizen.requestscancel)" pos="70 23"
            size="37 16" source="minecolonies:textures/gui/citizen/colonist_button_small.png" />
</window>
