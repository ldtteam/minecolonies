<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="190 244">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text id="desc" size="150 11" pos="20 14" label="$(com.minecolonies.gui.workerhuts.stable.patroltargets)" color="black" textalign="MIDDLE"/>
    <text id="targetCount" size="150 11" pos="20 28" color="black" textalign="MIDDLE"/>
    <list id="patrolTargets" size="170 136" pos="13 45">
        <box size="100% 17" linewidth="1">
            <text id="targetName" size="120 12" pos="5 2" color="black"/>
            <image id="activePatrol"
                pos="128 1"
                size="14 14"
                source="minecolonies:textures/gui/modules/horse.png"/>
            <checkbox id="targetSelected" pos="145 2" size="12 12"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
                disabled="minecolonies:textures/gui/builderhut/builder_button_mini_disabled.png"
                checkmark="minecolonies:textures/gui/builderhut/builder_button_mini_check.png"/>
        </box>
    </list>
</window>
