                    size="29 15" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" />
        </box>
    </list>
    <button id="resetDefault" color="black" label="$(com.minecolonies.coremod.gui.workerhuts.resetdefault)" pos="50 194"
            size="86 17" source="minecolonies:textures/gui/builderhut/builder_button_medium.png" />
</window>
