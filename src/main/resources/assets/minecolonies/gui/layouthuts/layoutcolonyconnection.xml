<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="190 244" >
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text id="desc" size="120 100" pos="30 10" color="black" textscale="1.0" label="$(com.minecolonies.core.gui.colonylist.desc)"/>
    <list id="colonylist" size="164 170" pos="13 40">
        <box size="100% 30" linewidth="1">
            <text id="name" size="100 12" pos="0 3" color="black"/>
            <text id="distance" size="50 12" pos="2 18" color="black"/>
            <text id="state" size="100% 12" pos="0 18" color="black"/>

            <button id="requestally" size="14 15" label="$(com.minecolonies.core.gui.colonylist.request_ally)" pos="100 12"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black"/>
            <button id="startfeud" size="14 15" label="$(com.minecolonies.core.gui.colonylist.start_feud)" pos="100 50"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black"/>

            <button id="setneutral" size="14 15" label="$(com.minecolonies.core.gui.colonylist.set_neutral)" pos="100 12"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black" visible="false"/>

            <button id="teleport" size="14 15" label="↥" pos="150 12"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black"/>
        </box>
    </list>
</window>
