<window size="190 244"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image size="190 244" source="minecolonies:textures/gui/builderhut/builder_paper.png" />
    <text id="desc" color="black" label="$(com.minecolonies.core.gui.colonylist.direct.desc)" pos="10 15" size="170 10" textalign="MIDDLE" textscale="1.0" />
    <list id="directcolonylist" pos="13 25" size="164 80">
        <box linewidth="1" size="100% 40">
            <text id="name" color="black" pos="2 1" size="140 12" />
            <text id="distance" color="black" pos="70 10" size="80 12" />
            <text id="state" color="black" pos="2 10" size="100% 12" />

            <button id="travel" color="black" label="$(com.minecolonies.core.gui.colonylist.travel)" pos="32 22"
                    size="86 17" source="minecolonies:textures/gui/builderhut/builder_button_medium.png" tooltip="$(com.minecolonies.core.gui.colonylist.travel.tooltip)" />
        </box>
    </list>
    <text id="desc" color="black" label="$(com.minecolonies.core.gui.colonylist.indirect.desc)" pos="10 110" size="170 10" textalign="MIDDLE" textscale="1.0" />
    <list id="indirectcolonylist" pos="13 125" size="164 80">
        <box linewidth="1" size="100% 40">
            <text id="name" color="black" pos="2 1" size="140 12" />
            <text id="distance" color="black" pos="70 10" size="80 12" />
            <text id="state" color="black" pos="2 10" size="100% 12" />

            <button id="travel" color="black" label="$(com.minecolonies.core.gui.colonylist.travel)" pos="32 22"
                    size="86 17" source="minecolonies:textures/gui/builderhut/builder_button_medium.png" tooltip="$(com.minecolonies.core.gui.colonylist.travel.tooltip)" />
        </box>
    </list>
</window>
