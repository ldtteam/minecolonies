<window size="400 244" type="VANILLA" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image size="400 244" source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png" />

    <button id="cancel" color="black" pos="375 10" size="14 15" source="minecolonies:textures/gui/button_x.png" />

    <text id="warningtext" color="black" pos="70 15" size="260 120" textalign="MIDDLE" textscale="1" />

    <button id="pickup" color="black" disabled="minecolonies:textures/gui/builderhut/builder_button_medium_large_disabled.png" label="$(com.minecolonies.core.founding.pickup)"
            pos="70 150"
            size="129 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" />

    <button id="delete" color="black" disabled="minecolonies:textures/gui/builderhut/builder_button_medium_large_disabled.png" label="$(com.minecolonies.core.founding.delete)"
            pos="200 150"
            size="129 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" />

    <button id="abandon" color="black" disabled="minecolonies:textures/gui/builderhut/builder_button_medium_large_disabled.png" label="$(com.minecolonies.core.founding.abandon)"
            pos="130 180"
            size="129 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" />

    <image id="dialog" pos="72 35" size="256 180" source="minecolonies:textures/gui/dialog.png" visible="false" />

    <text id="confirmtext" color="black" hide="true" pos="100 30" size="200 120" textalign="MIDDLE" textscale="1" visible="false" />

    <button id="confirmdelete" color="black" label="$(com.minecolonies.core.gui.colony.delete.confirm)" pos="110 160"
            size="86 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" visible="false" />

    <button id="confirmabandon" color="black" label="$(com.minecolonies.core.gui.colony.abandon.confirm)" pos="110 160"
            size="86 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" visible="false" />

    <button id="cancelaction" color="black" label="$(com.minecolonies.core.gui.colony.manage.cancel)" pos="210 160"
            size="86 17"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" visible="false" />
</window>
